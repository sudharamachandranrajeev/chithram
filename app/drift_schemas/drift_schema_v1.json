  "fixed_sql": [
    {
      "name": "http_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"http_cache\" (\"key\" TEXT NOT NULL, \"parser_ver\" INTEGER NOT NULL, \"etag\" TEXT NULL, \"last_modified\" TEXT NULL, \"fetched_at\" INTEGER NOT NULL, \"soft_expiry\" INTEGER NOT NULL, \"hard_expiry\" INTEGER NOT NULL, \"body\" BLOB NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "plugin_repos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plugin_repos\" (\"id\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"key_id\" TEXT NOT NULL, \"pinned_pub\" TEXT NOT NULL, \"etag\" TEXT NULL, \"last_checked_at\" INTEGER NULL, \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "plugins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plugins\" (\"id\" TEXT NOT NULL, \"repo_id\" TEXT NULL, \"engine_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"version\" TEXT NULL, \"sha256\" TEXT NOT NULL, \"source_url\" TEXT NOT NULL, \"declared_url\" TEXT NOT NULL, \"allowed_hosts\" TEXT NOT NULL, \"signed\" INTEGER NOT NULL CHECK (\"signed\" IN (0, 1)), \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"installed_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"update_sha\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "torznab_endpoints",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"torznab_endpoints\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"base_url\" TEXT NOT NULL, \"caps\" TEXT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"caps_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "provider_runs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"provider_runs\" (\"provider_id\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"reason\" TEXT NULL, \"ms\" INTEGER NOT NULL, \"results\" INTEGER NOT NULL, \"requests\" INTEGER NOT NULL, \"blocked_hosts\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "http_cache_hard_expiry",
      "sql": [
        {
